<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="straight_road_world">

    <include>
      <uri>model://sun</uri>
    </include>

    <light name="fill_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>35 0 30 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.5 -1</direction>
    </light>

    <model name="ground_box">
  <static>true</static>
  <pose>35 0 -0.05 0 0 0</pose>
  <link name="ground_link">
    <collision name="ground_collision">
      <geometry><box><size>100 18 0.1</size></box></geometry>
    </collision>
    <visual name="ground_visual">
      <geometry><box><size>100 18 0.1</size></box></geometry>
      <material>
        <ambient>0.1 0.35 0.15 1</ambient>   <!-- Xanh lá đậm -->
        <diffuse>0.15 0.5 0.25 1</diffuse>    <!-- Xanh lá tươi -->
        <specular>0.02 0.02 0.02 1</specular> <!-- Ít phản xạ -->
      </material>
    </visual>
  </link>
</model>
    <!-- Road rộng 12m -->
    <model name="road_surface">
      <static>true</static>
      <pose>35 0 0.001 0 0 0</pose>
      <link name="road_link">
        <collision name="road_collision">
          <geometry><box><size>70 12 0.02</size></box></geometry>
        </collision>
        <visual name="road_visual">
          <geometry><box><size>70 12 0.02</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.3 0.3 0.33 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Edge lines: y = ±5.925 -->
    <model name="line_left_edge">
      <static>true</static>
      <pose>35 5.925 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>70 0.15 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="line_right_edge">
      <static>true</static>
      <pose>35 -5.925 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>70 0.15 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Lane lines: 3 lanes (each 4m): y = ±2.0 -->
    <model name="line_lane_12">
      <static>true</static>
      <pose>35 2.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>70 0.12 0.01</size></box></geometry>
          <material><ambient>0.9 0.8 0.05 1</ambient><diffuse>1 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="line_lane_23">
      <static>true</static>
      <pose>35 -2.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>70 0.12 0.01</size></box></geometry>
          <material><ambient>0.9 0.8 0.05 1</ambient><diffuse>1 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

