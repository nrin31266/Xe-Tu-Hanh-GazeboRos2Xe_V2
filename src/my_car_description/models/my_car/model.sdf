<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="my_car">
    <static>false</static> <!-- false => model có thể di chuyển -->

    <!-- ================== BASE LINK ================== -->
    <link name="base_link">
      <pose>0 0 0.18 0 0 0</pose> <!-- x y trong_tam roll pitch yaw -->

      <inertial>
  <mass>10.0</mass> <!-- kg -->
  <inertia>
    <ixx>0.8</ixx><iyy>1.0</iyy><izz>1.2</izz> <!-- MO MEN QUAN TINH -->
    <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
  </inertia>
</inertial>


      <collision name="base_col">
        <geometry><box><size>0.90 0.45 0.22</size></box></geometry>
      </collision>

      <visual name="base_vis">
  <geometry><box><size>0.90 0.45 0.22</size></box></geometry>
  <material>
    <ambient>0.80 0.05 0.05 1</ambient>
    <diffuse>0.80 0.05 0.05 1</diffuse>
  </material>
</visual>

      <!-- CABIN (small rectangle on top) -->
     <visual name="cabin_vis">
  <pose>-0.10 0 0.20 0 0 0</pose>
  <geometry><box><size>0.45 0.40 0.20</size></box></geometry>
  <material>
    <ambient>0.95 0.95 0.95 1</ambient>
    <diffuse>0.95 0.95 0.95 1</diffuse>
  </material>
</visual>

<!-- ================== FAKE LIDAR BODY (just for display) ================== -->
<visual name="lidar_body_vis">
  <!-- đặt đúng vị trí của sensor lidar -->
  <pose>0.30 0 0.18 0 0 0</pose>

  <geometry>
    <cylinder>
      <radius>0.03</radius>
      <length>0.17</length>
    </cylinder>
  </geometry>

  <material>
    <ambient>0.15 0.15 0.15 1</ambient>
    <diffuse>0.15 0.15 0.15 1</diffuse>
  </material>
</visual>

      <!-- ================== LIDAR (publish /scan) ================== -->
<sensor name="lidar" type="ray">
  <pose>0.30 0 0.22 0 0 0</pose>

  <always_on>true</always_on>
  <visualize>true</visualize>
  <update_rate>20</update_rate>

  <ray>
    <scan>
      <horizontal>
        <samples>120</samples>
        <resolution>1</resolution>
        <min_angle>-1.0472</min_angle> <!-- -60 do -->
        <max_angle>1.0472</max_angle> <!-- +60 do -->
      </horizontal>
    </scan>

    <range>
      <min>0.12</min>
      <max>8.0</max>
      <resolution>0.01</resolution>
    </range>

    <noise> <!-- noise model -->
      <type>gaussian</type>
      <mean>0.0</mean>
      <stddev>0.0</stddev>
    </noise>
  </ray>

  <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
    <ros>
      <remapping>out:=/gazebo_ros_laser/out</remapping>
    </ros>
    <output_type>sensor_msgs/LaserScan</output_type>
    <frame_name>base_link</frame_name>
  </plugin>
</sensor>

    </link>

    <!-- ================== WHEELS ================== -->
    <!-- radius=0.08 => tâm bánh đặt z ~ 0.10 -->
    <!-- y=±0.26 => wheel_separation=0.52 -->

    <!-- FRONT LEFT -->
    <link name="front_left_wheel">
      <pose>0.30 0.26 0.10 0 0 0</pose>
      <inertial><mass>0.6</mass></inertial>

      <collision name="col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode> <!-- hệ số ma sát -->
          </friction>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
       <material>
  <ambient>0.02 0.02 0.02 1</ambient>
  <diffuse>0.02 0.02 0.02 1</diffuse>
</material>

      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- FRONT RIGHT -->
    <link name="front_right_wheel">
      <pose>0.30 -0.26 0.10 0 0 0</pose>
      <inertial><mass>0.6</mass></inertial>

      <collision name="col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
       <material>
  <ambient>0.02 0.02 0.02 1</ambient>
  <diffuse>0.02 0.02 0.02 1</diffuse>
</material>

      </visual>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- REAR LEFT (DRIVEN) -->
    <link name="rear_left_wheel">
      <pose>-0.30 0.26 0.10 0 0 0</pose>
      <inertial><mass>0.6</mass></inertial>

      <collision name="col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
      <material>
  <ambient>0.02 0.02 0.02 1</ambient>
  <diffuse>0.02 0.02 0.02 1</diffuse>
</material>

      </visual>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- REAR RIGHT (DRIVEN) -->
    <link name="rear_right_wheel">
      <pose>-0.30 -0.26 0.10 0 0 0</pose>
      <inertial><mass>0.6</mass></inertial>

      <collision name="col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
       <material>
  <ambient>0.02 0.02 0.02 1</ambient>
  <diffuse>0.02 0.02 0.02 1</diffuse>
</material>

      </visual>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <!-- ================== DIFF DRIVE PLUGIN ================== -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>

      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>0.52</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <wheel_diameter>0.16</wheel_diameter>

      <update_rate>30</update_rate>
      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>
      <odom_frame>odom</odom_frame>

      <base_frame>base_link</base_frame>
    </plugin>



  </model>
</sdf>
